# Copy to .env and fill in. All values are optional except where noted.

# Which setup you chose in the Meta dashboard:
#   instagram = "Instagram API with Instagram Login"  (graph.instagram.com, no FB Page)
#   facebook  = "Instagram API with Facebook Login"   (graph.facebook.com, needs FB Page)
API_MODE=instagram

# Graph API version (bump if Meta deprecates it)
GRAPH_VERSION=v21.0

# Optional: prefill so you don't paste the token in the UI every run.
ACCESS_TOKEN=

# Optional: skip account lookup by hardcoding the IG user id.
IG_USER_ID=

# Change for anything beyond local testing.
FLASK_SECRET=dev-secret-change-me
